From 3accc5de2cc79ad6de04f8b09b081a2d9a405448 Mon Sep 17 00:00:00 2001
From: DataViewer-Desktop Sync <sync@dataviewer-desktop.local>
Date: Thu, 20 Aug 2026 14:21:00 +0800
Subject: [PATCH 13/15] fix(desktop): Windows path/CRLF production bugs found
 by CI
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- aggregation manifest 键 POSIX 化（os.sep→/）：Windows 上反斜杠键使
  diff/status/token 层正斜杠查询全部落空 → 全条目误报 added
- pangu_to_atif 字节分块窗口吸收 CRLF 空行：end_line 计数与 LF 一致
- Linux 行为逐字节不变（fork 全量 921/1/2）

Co-Authored-By: Claude <noreply@anthropic.com>
---
 backend/services/aggregation_worker.py |  9 +++++++--
 backend/services/pangu_to_atif.py      | 26 +++++++++++++++++++++++---
 2 files changed, 30 insertions(+), 5 deletions(-)

diff --git a/backend/services/aggregation_worker.py b/backend/services/aggregation_worker.py
index da70c60..5abdfb7 100644
--- a/backend/services/aggregation_worker.py
+++ b/backend/services/aggregation_worker.py
@@ -297,8 +297,13 @@ def run_round_creation_sync(round_id: str) -> None:
             if src_sha != dst_sha or src_size != dst_size:
                 raise ValueError(f"Copy verification failed: {rel}")
             manifest_rows.append({
-                "rel_path": rel, "size": dst_size, "mtime_ns": dst_mtime,
-                "sha256": dst_sha, "line_count": dst_lines,
+                # DB keys must be POSIX-separated on every platform: the diff /
+                # export / token layers split on "/" and compare against
+                # fast_scan's "/"-joined keys, and os.path.relpath is
+                # "\\"-separated on Windows. Filesystem paths above keep the
+                # native separator.
+                "rel_path": rel.replace(os.sep, "/"), "size": dst_size,
+                "mtime_ns": dst_mtime, "sha256": dst_sha, "line_count": dst_lines,
             })
             verified += 1
             if verified % 10 == 0 or verified == total:
diff --git a/backend/services/pangu_to_atif.py b/backend/services/pangu_to_atif.py
index 495d1f0..959f340 100644
--- a/backend/services/pangu_to_atif.py
+++ b/backend/services/pangu_to_atif.py
@@ -220,10 +220,12 @@ def iter_byte_bounded_chunks(
                 line_start = end_line
                 return window
 
+            last_blank = True
             for i, raw in enumerate(data_parts[:-1]):
                 raw_len = len(raw)
+                stripped = text_parts[i].strip()
+                last_blank = not stripped
                 if lineno >= line_start:
-                    stripped = text_parts[i].strip()
                     if stripped:
                         pending.append((lineno, stripped))
                         if len(pending) >= max_lines:
@@ -235,8 +237,9 @@ def iter_byte_bounded_chunks(
             if not data.endswith(b"\n") and data_parts[-1]:
                 # Final line of the file without a trailing newline.
                 raw_len = len(data_parts[-1])
+                stripped = text_parts[-1].strip()
+                last_blank = not stripped
                 if lineno >= line_start:
-                    stripped = text_parts[-1].strip()
                     if stripped:
                         pending.append((lineno, stripped))
                         if len(pending) >= max_lines:
@@ -246,7 +249,24 @@ def iter_byte_bounded_chunks(
                 buf_pos += raw_len
                 lineno += 1
             if pending and len(data) >= max_bytes:
-                window = flush(lineno, f.tell())
+                end_line, end_byte = lineno, f.tell()
+                if not last_blank:
+                    # Absorb ONE trailing blank line into the window so
+                    # end_line / end_byte_offset are identical across line
+                    # endings: byte-bounded read-ahead stops at the first
+                    # \n-terminated tail, so whether a blank after the last
+                    # content line already fell inside this chunk is an
+                    # alignment accident (an LF blank is 1 byte, a CRLF blank 2
+                    # — e.g. Windows text-mode writes). The blank's bytes stay
+                    # unconsumed in the file, so a resumed reader skips them
+                    # cleanly via the line_start guard.
+                    pos = f.tell()
+                    peek = f.read(2)
+                    f.seek(pos)
+                    if peek in (b"\n", b"\r\n"):
+                        end_line += 1
+                        end_byte += len(peek)
+                window = flush(end_line, end_byte)
                 if window is not None:
                     yield window
         if pending:
