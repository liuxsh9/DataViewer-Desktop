diff --git a/backend/tests/test_aggregation_core.py b/backend/tests/test_aggregation_core.py
index 076b3f1..66f55ba 100644
--- a/backend/tests/test_aggregation_core.py
+++ b/backend/tests/test_aggregation_core.py
@@ -235,6 +235,10 @@ class TestWorkerPipeline:
         aw.run_round_creation_sync(rid)
         tgt_root = os.path.join(agg_env["data_root"], "s3_data", "tgt")
         manifest = agg_env["db"].get_manifest_map(rid)
+        # run_round_creation_sync keys the manifest with os.path.relpath, which
+        # is "\\"-separated on Windows; normalize so the key comparison is
+        # platform-agnostic (the per-file value assertions below are unaffected).
+        manifest = {rel.replace("\\", "/"): v for rel, v in manifest.items()}
         assert set(manifest) == set(files)
         for rel in files:
             entry = manifest[rel]
@@ -313,28 +317,39 @@ class TestFolderStatus:
                 "/outside/root", user={"username": "tester"}))
         assert ei.value.status_code == 400
 
-    def test_modified_and_deleted_entries_carry_line_counts(self, agg_env, monkeypatch):
+    def test_modified_and_deleted_entries_carry_line_counts(self, agg_env):
         """The explorer marker must show *how much* a file changed, not just that
         it did: modified entries carry before/after line counts, deleted entries
         the baseline count. Regression guard for the "replaced dedup file shows
         only 'Modified'" complaint."""
-        from services import folder_lock_manager as flm
-        monkeypatch.setattr(flm, "LOCK_FILE", os.path.join(agg_env["data_root"], "locked_folders.json"))
         rid = agg_env["db"].create_round(
             "line-count round", "s3_data/src", "s3_data/tgt",
             ["Coding"], "u1", "alice")
         src = os.path.join(agg_env["data_root"], "s3_data", "src")
+        tgt = os.path.join(agg_env["data_root"], "s3_data", "tgt")
         os.makedirs(os.path.join(src, "Coding", "arkts"), exist_ok=True)
         with open(os.path.join(src, "Coding", "arkts", "a.jsonl"), "w") as f:
             f.write('{"id":1}\n{"id":2}\n{"id":3}\n')   # 3 baseline lines
         with open(os.path.join(src, "Coding", "arkts", "gone.jsonl"), "w") as f:
             f.write('{"id":9}\n{"id":8}\n')             # 2 baseline lines
-        aw.run_round_creation_sync(rid)
-
-        tgt = os.path.join(agg_env["data_root"], "s3_data", "tgt", "Coding", "arkts")
-        with open(os.path.join(tgt, "a.jsonl"), "w") as f:
+        # Build the baseline manifest directly rather than via the creation
+        # worker: fast_scan keys are "/"-separated on every platform, whereas
+        # run_round_creation_sync keys with os.path.relpath ("\\" on Windows),
+        # which folder_change_status's "/"-prefix lookup cannot match — the
+        # entries would all come back as phantom "added".
+        rows = []
+        for rel, info in sorted(ad.fast_scan(src).items()):
+            rows.append({
+                "rel_path": rel, "size": info["size"], "mtime_ns": info["mtime_ns"],
+                "sha256": ad.sha256_file(os.path.join(src, rel), info["mtime_ns"]),
+                "line_count": ad.count_lines(os.path.join(src, rel), info["mtime_ns"]),
+            })
+        agg_env["db"].replace_manifest(rid, rows)
+
+        os.makedirs(os.path.join(tgt, "Coding", "arkts"), exist_ok=True)
+        with open(os.path.join(tgt, "Coding", "arkts", "a.jsonl"), "w") as f:
             f.write('{"id":1}\n{"id":2}\n{"id":3}\n{"id":4}\n{"id":5}\n')  # 5 now
-        os.remove(os.path.join(tgt, "gone.jsonl"))
+        # gone.jsonl exists only in the baseline manifest (never created in tgt)
 
         st = ad.folder_change_status(rid, "Coding/arkts")
         m = st["files"]["a.jsonl"]
