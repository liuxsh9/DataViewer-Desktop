diff --git a/backend/services/quality_ray_workers.py b/backend/services/quality_ray_workers.py
index 2251d42..1e7b2a0 100644
--- a/backend/services/quality_ray_workers.py
+++ b/backend/services/quality_ray_workers.py
@@ -6,7 +6,6 @@ Properly distributed quality check using Ray Tasks:
 - Each chunk processed in parallel as Ray remote tasks
 - Ray scheduler distributes tasks across cluster resources
 """
-import ray
 import os
 import json
 import logging
@@ -14,11 +13,60 @@ from pathlib import Path
 from typing import Dict, List, Any, Iterator
 import orjson
 
+import config
+
 logger = logging.getLogger(__name__)
 
+# ray is an optional dependency (extra: quality_ray). Keep this module
+# importable without it: entry points raise a clear error instead. When the
+# QUALITY_RAY_ENABLED switch is off, ray is never imported at all.
+if config.QUALITY_RAY_ENABLED:
+    try:
+        import ray
+        RAY_AVAILABLE = True
+    except ImportError:
+        RAY_AVAILABLE = False
+        logger.warning(
+            "ray not installed; distributed quality check unavailable "
+            "(install with `pip install -e '.[quality_ray]'`)"
+        )
+else:
+    RAY_AVAILABLE = False
+    logger.info("Ray distributed quality check disabled (QUALITY_RAY_ENABLED=false)")
+
+
+def _require_ray():
+    """Return the ray module, or raise a clear error when unavailable/disabled."""
+    if not config.QUALITY_RAY_ENABLED:
+        raise RuntimeError(
+            "Ray distributed quality check is disabled (QUALITY_RAY_ENABLED=false)"
+        )
+    if not RAY_AVAILABLE:
+        raise RuntimeError(
+            "ray is not installed; distributed quality check requires the "
+            "quality_ray extra: `pip install -e '.[quality_ray]'`"
+        )
+    return ray
+
+
+def _ray_remote(**kwargs):
+    """Apply @ray.remote when available, otherwise act as an identity decorator.
+
+    Keeps module import safe without ray; entry points call _require_ray()
+    and raise before any .remote() attribute is reached.
+    """
+    if RAY_AVAILABLE:
+        return ray.remote(**kwargs)
+
+    def _identity(obj):
+        return obj
+
+    return _identity
+
 
 def init_ray():
     """Initialize Ray connection"""
+    ray = _require_ray()
     ray.init(
         address="ray://10.170.22.55:10001",
         runtime_env={
