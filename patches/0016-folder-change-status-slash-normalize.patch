- Windows 上 os.path.normpath 把 round-root 相对目录转反斜杠，
  下游 LIKE/rel 拼接/rsplit 全是正斜杠契约 → 基线查不到 → 全误报 added
- 与 aggregation_journal.py:50 同款 .replace 归一化；Linux no-op

Co-Authored-By: Claude <noreply@anthropic.com>
---
 backend/services/aggregation_diff.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/backend/services/aggregation_diff.py b/backend/services/aggregation_diff.py
index 6eca909..c2fc7e9 100644
--- a/backend/services/aggregation_diff.py
+++ b/backend/services/aggregation_diff.py
@@ -604,7 +604,11 @@ def folder_change_status(round_id: str, dir_rel_root: str) -> Dict[str, Any]:
     # subtree came back as phantom "added". `..` was worse — it walked straight
     # out of the round. The HTTP layer normalizes too, but this function is
     # callable on its own and must not depend on someone else's guard.
-    dir_rel = os.path.normpath((dir_rel_root or "").strip("/")).strip("/")
+    # normpath() on Windows turns the "/"-separated round-root-relative path
+    # into backslashes; every consumer below (manifest LIKE, rel joins,
+    # rsplit) is a "/" contract, so normalize back (same pattern as
+    # aggregation_journal.py:50). Linux normpath is a no-op here.
+    dir_rel = os.path.normpath((dir_rel_root or "").strip("/")).strip("/").replace("\\", "/")
     if dir_rel in (".", ""):
         dir_rel = ""
     if dir_rel.startswith("..") or "/../" in f"/{dir_rel}/":
