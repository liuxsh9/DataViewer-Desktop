+# ---------------------------------------------------------------------------
+# Group 5b — multi-root drive browsing (D16)
+# ---------------------------------------------------------------------------
+
+@pytest.mark.skipif(sys.platform != "win32",
+                    reason="drive-root enumeration is a Windows concept")
+def test_win32_allowed_roots_enumerates_drives():
+    # The desktop File Explorer exposes each mounted drive as a browsable root
+    # alongside the app data root (D16). The data root is always present; a
+    # real Windows machine always has at least C:.
+    assert "data" in files.ALLOWED_ROOTS
+    assert "C:" in files.ALLOWED_ROOTS
+    assert files.ALLOWED_ROOTS["C:"] in ("C:\\", "c:\\")
+
+
+@pytest.mark.skipif(sys.platform != "win32",
+                    reason="drive letters are a Windows concept")
+def test_win32_safe_path_drive_absolute_and_cross_drive(monkeypatch):
+    monkeypatch.setattr(files, "get_data_root", lambda: "C:\\")
+    # Drive-absolute path under the current root is not double-rooted.
+    assert files.safe_path("C:\\Users\\me\\f.jsonl") == \
+        Path("C:\\Users\\me\\f.jsonl").resolve()
+    # Root-relative forward-slash form resolves under the drive root.
+    assert files.safe_path("Users/me/f.jsonl") == \
+        Path("C:\\Users\\me\\f.jsonl").resolve()
+    # The root itself.
+    assert files.safe_path("") == Path("C:\\").resolve()
+    # A path on a different drive is outside the root -> 400.
+    with pytest.raises(HTTPException) as exc:
+        files.safe_path("D:\\other\\f.jsonl")
+    assert exc.value.status_code == 400
+
