+    """Ensure path is within the current root.
+
+    Accepts both root-relative (`s3_data/...`) and root-absolute (the root's
+    native notation, e.g. `/data/s3_data/...` on POSIX or `C:\\s3_data\\...` on
+    Windows) forms — the latter must not be joined under the root again (that
+    produced `/data/data/...` and a misleading 404 "Path not found" for folders
+    that exist). Mirrors the convention already used by `api.aggregation._resolve_rel`.
+
+    Any other absolute path (e.g. `/etc/passwd` on POSIX) keeps the legacy
+    semantics: leading separators are stripped and the path is treated as
+    root-relative. Pathlib handles the platform separator/drive-letter details
+    (forward vs back slash, `C:` vs `C:\\`, case-insensitive `relative_to`).
     """
-    DATA_ROOT = get_data_root()
-    root = Path(DATA_ROOT).resolve()
-    s = str(path)
-    root_s = str(root)
-    if s == root_s:
-        rel = ""
-    elif s.startswith(root_s + "/"):
-        rel = s[len(root_s):].lstrip("/")
+    root = Path(get_data_root()).resolve()
+    if not path:
+        return root
+    p = Path(path)
+    if p.is_absolute():
+        # Absolute path. Only a root-prefixed one is "already absolute"; anything
+        # else falls through to the legacy root-relative interpretation below.
+        try:
+            p.resolve().relative_to(root)
+            full_path = p.resolve()
+        except ValueError:
+            full_path = (root / str(path).lstrip("/\\")).resolve()
     else:
-        rel = path.lstrip("/")
-    full_path = (root / rel).resolve()
+        full_path = (root / str(path).lstrip("/\\")).resolve()
     try:
         full_path.relative_to(root)
         return full_path
