-# Configurable root paths
+# Configurable root paths. The File Explorer can browse multiple roots: the
+# app's data root plus, on Windows, every mounted drive root (C:\, D:\ ...
+# including removable/USB drives) so users can reach their files the way a
+# native Windows Explorer does. The drive list is probed once at import; the
+# rest of the backend is platform-agnostic and only ever sees this uniform
+# mapping (hot-plug refresh is out of scope for the first release).
 from config import DATA_ROOT as _CONFIG_DATA_ROOT
-ALLOWED_ROOTS = {
-    "data": _CONFIG_DATA_ROOT,
-    "home": "/home"
-}
 
-# Current active root path (default to /data)
+def _discover_roots() -> dict:
+    import string
+    roots = {"data": _CONFIG_DATA_ROOT}
+    if os.name == "nt":
+        for letter in string.ascii_uppercase:
+            drive = f"{letter}:\\"
+            if os.path.exists(drive):
+                roots[f"{letter}:"] = drive
+    else:
+        roots["home"] = "/home"
+    return roots
+
+ALLOWED_ROOTS = _discover_roots()
+
+# Current active root path (default to the data root)
 _current_root = "data"
 
