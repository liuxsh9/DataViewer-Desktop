 def get_db_path(filename: str) -> str:
     """Return the full path for a database file under METADATA_DIR."""
@@ -166,6 +237,31 @@ def get_data_root() -> str:
     return DATA_ROOT
 
 
+def resolve_abs_path(rel: str) -> str:
+    """Map a root-relative path (as stored in the DB) to an absolute one.
+
+    DATA_ROOT is the File Explorer root; ``rel`` is stored without a leading
+    separator. Replaces the scattered ``f"/data/{p}"`` joins.
+    """
+    return os.path.normpath(os.path.join(DATA_ROOT, rel.lstrip("/\\")))
+
+
+def strip_data_root(abs_path: str) -> str:
+    """Inverse of :func:`resolve_abs_path`: absolute path → root-relative.
+
+    The root itself maps to ``""``. Paths outside DATA_ROOT are returned
+    unchanged (callers keep their existing guards).
+    """
+    root = os.path.normpath(DATA_ROOT)
+    path = os.path.normpath(str(abs_path))
+    if path == root:
+        return ""
+    prefix = root + os.sep
+    if path.startswith(prefix):
+        return path[len(prefix):]
+    return path
+
+
 def validate_config():
     """Log warnings for missing required configuration. Call at startup."""
     warnings = []
diff --git a/backend/tests/test_config_secrets.py b/backend/tests/test_config_secrets.py
