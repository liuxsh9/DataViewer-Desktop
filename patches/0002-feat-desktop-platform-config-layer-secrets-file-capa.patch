+++ b/backend/config.py
@@ -8,6 +8,44 @@ from pathlib import Path
 
 logger = logging.getLogger(__name__)
 
+
+def _env_bool(name: str, default: bool) -> bool:
+    """Read a boolean env switch. Used by the capability kill switches below."""
+    return os.getenv(name, "true" if default else "false").lower() in ("true", "1", "yes")
+
+
+def _load_secrets_file() -> None:
+    """Lowest-priority config source for the single-machine desktop build.
+
+    The launcher writes generated secrets (JWT_SECRET_KEY, ADMIN_PASSWORD, ...)
+    to a ``KEY=VALUE`` file and points ``DV_SECRETS_FILE`` at it. Values are
+    injected via ``os.environ.setdefault`` so the precedence is
+
+        system env > secrets file > code defaults
+
+    and an already-exported env var is never overridden. No file configured
+    (or an unreadable one) leaves behavior exactly as before.
+    """
+    path = os.getenv("DV_SECRETS_FILE")
+    if not path:
+        return
+    try:
+        with open(path, encoding="utf-8") as f:
+            for line in f:
+                line = line.strip()
+                if not line or line.startswith("#") or "=" not in line:
+                    continue
+                key, _, value = line.partition("=")
+                os.environ.setdefault(key.strip(), value.strip())
+    except FileNotFoundError:
+        logger.warning("[Config] secrets file not found: %s", path)
+    except OSError as exc:
+        logger.warning("[Config] failed to read secrets file %s: %s", path, exc)
+
+
+# Must run before any getenv() below so secrets participate in defaults.
+_load_secrets_file()
+
