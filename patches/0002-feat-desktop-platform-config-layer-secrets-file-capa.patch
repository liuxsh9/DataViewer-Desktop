--- /dev/null
+++ b/backend/tests/test_config_secrets.py
@@ -0,0 +1,79 @@
+"""Config platform layer: secrets-file precedence, path helpers, capability switches.
+
+Covers the DataViewer-Desktop config additions (project plan §4.1/4.5/4.6).
+Linux upstream behavior must stay unchanged: all capability switches default
+to enabled, and no DV_SECRETS_FILE configured means the config is read exactly
+as before.
+"""
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import config
+
+
+def test_secrets_file_precedence(tmp_path, monkeypatch):
+    """System env beats secrets file; secrets file beats defaults (mechanism)."""
+    secrets = tmp_path / "secrets.env"
+    secrets.write_text("# comment\nJWT_SECRET_KEY=from_file\nADMIN_PASSWORD=pw_from_file\n")
+    monkeypatch.setenv("DV_SECRETS_FILE", str(secrets))
+    monkeypatch.setenv("JWT_SECRET_KEY", "from_env")          # env must win
+    monkeypatch.delenv("ADMIN_PASSWORD", raising=False)       # file must fill
+
+    config._load_secrets_file()
+
+    assert os.environ["JWT_SECRET_KEY"] == "from_env"
+    assert os.environ["ADMIN_PASSWORD"] == "pw_from_file"
+
+
+def test_secrets_loaded_at_import_time(tmp_path):
+    """The loader runs before module-level getenv calls (import-time injection)."""
+    secrets = tmp_path / "secrets.env"
+    secrets.write_text("ADMIN_PASSWORD=pw_from_file\n")
+    env = os.environ.copy()
+    env["DV_SECRETS_FILE"] = str(secrets)
+    env.pop("ADMIN_PASSWORD", None)
+    code = "import config; print(config.ADMIN_PASSWORD)"
+    backend_dir = Path(config.__file__).resolve().parent
+
+    proc = subprocess.run(
+        [sys.executable, "-c", code],
+        capture_output=True, text=True, env=env, cwd=backend_dir, timeout=60,
+    )
+
+    assert proc.returncode == 0, proc.stderr
+    assert proc.stdout.strip() == "pw_from_file"
+
+
+def test_resolve_abs_path_strips_leading_separators(monkeypatch):
+    monkeypatch.setattr(config, "DATA_ROOT", "/tmp/dv-root")
+    assert config.resolve_abs_path("a/b.jsonl") == "/tmp/dv-root/a/b.jsonl"
+    assert config.resolve_abs_path("/a/b.jsonl") == "/tmp/dv-root/a/b.jsonl"
+
+
+def test_strip_data_root_roundtrip(monkeypatch):
+    monkeypatch.setattr(config, "DATA_ROOT", "/tmp/dv-root")
+    assert config.strip_data_root("/tmp/dv-root/a/b.jsonl") == "a/b.jsonl"
+    assert config.strip_data_root("/tmp/dv-root") == ""
+    # Outside DATA_ROOT: returned unchanged (callers keep their guards).
+    assert config.strip_data_root("/other/x") == "/other/x"
+
+
+def test_env_bool_parsing(monkeypatch):
+    monkeypatch.setenv("TEST_BOOL_ON", "yes")
+    monkeypatch.setenv("TEST_BOOL_OFF", "0")
+    assert config._env_bool("TEST_BOOL_ON", False) is True
+    assert config._env_bool("TEST_BOOL_OFF", True) is False
+    monkeypatch.delenv("TEST_BOOL_ON")
+    assert config._env_bool("TEST_BOOL_ON", False) is False
+    assert config._env_bool("TEST_BOOL_ON", True) is True
+
+
+def test_capabilities_default_all_enabled():
+    """Upstream behavior: every capability is on unless explicitly disabled."""
+    assert all(config.CAPABILITIES.values())
+    assert set(config.CAPABILITIES) == {
+        "gateway", "datalab", "hf", "arena", "claude", "s3",
+        "volcengine", "scp", "ray_quality", "traj_viz", "workbench",
+    }
