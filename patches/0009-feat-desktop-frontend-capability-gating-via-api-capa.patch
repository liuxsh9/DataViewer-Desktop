diff --git a/frontend/src/contexts/CapabilitiesContext.jsx b/frontend/src/contexts/CapabilitiesContext.jsx
new file mode 100644
index 0000000..bc156a4
--- /dev/null
+++ b/frontend/src/contexts/CapabilitiesContext.jsx
@@ -0,0 +1,64 @@
+import { createContext, useContext, useEffect, useState } from 'react';
+
+// Feature-availability flags for the desktop productization build
+// (DataViewer-Desktop): the backend reports which optional features are
+// enabled via GET /api/capabilities. Each key gates the UI entry points of
+// one feature — false means the entry is not rendered.
+//
+// The DEFAULT is all-true: when the endpoint is missing, unreachable or
+// returns an error, the app must behave exactly as upstream DataViewer does
+// today (no feature hidden). The fetch can therefore only ever NARROW flags,
+// never widen them past the default.
+const DEFAULT_CAPABILITIES = {
+  gateway: true,      // MindForge push / pull / format export
+  datalab: true,      // datalab-platform one-click quality check (validation)
+  hf: true,           // HuggingFace download
+  arena: true,        // LLM arena comparison (import)
+  claude: true,       // Ask Claude / Claude Chat / Claude Terminal
+  s3: true,           // S3 transfer
+  volcengine: true,   // Volcengine Ark provider
+  ray_quality: true,  // Ray distributed quality check
+  traj_viz: true,     // trajectory visualization (traj-viz, traj-lens)
+  workbench: true,    // SFT Pipeline Workbench
+  scp: true,          // SCP server transfer
+};
+
+const CapabilitiesContext = createContext(DEFAULT_CAPABILITIES);
+
+export const useCapabilities = () => useContext(CapabilitiesContext);
+
+// App-level provider: fetches /api/capabilities once at startup, independent
+// of the auth flow, so the login page and unauthenticated renders are gated
+// identically. Plain fetch (NOT the axios `api` instance): the axios
+// interceptor treats 401 as "session expired" and reloads the page — wrong
+// for a startup probe. Any failure falls back to DEFAULT_CAPABILITIES.
+export function CapabilitiesProvider({ children }) {
+  const [capabilities, setCapabilities] = useState(DEFAULT_CAPABILITIES);
+
+  useEffect(() => {
+    let cancelled = false;
+    fetch('/api/capabilities')
+      .then((res) => {
+        if (!res.ok) throw new Error(`capabilities fetch: HTTP ${res.status}`);
+        return res.json();
+      })
+      .then((data) => {
+        if (cancelled) return;
+        if (data && typeof data === 'object') {
+          setCapabilities((prev) => ({ ...prev, ...data }));
+        }
+      })
+      .catch(() => {
+        // Silent fallback: keep the all-true default (upstream behavior).
+      });
+    return () => { cancelled = true; };
+  }, []);
+
+  return (
+    <CapabilitiesContext.Provider value={capabilities}>
+      {children}
+    </CapabilitiesContext.Provider>
+  );
+}
+
+export default CapabilitiesContext;
