+"""Capabilities API — deployment feature switches.
+
+GET /api/capabilities exposes the ``config.CAPABILITIES`` registry as flat
+JSON (``{"gateway": true, "datalab": false, ...}``) so the frontend can gate
+UI entries per deployment. ``require_capability`` is the backend-side gate:
+routers that belong to a switchable capability (scp, claude, ...) declare it
+as a dependency and get an immediate 503 when the switch is off. Disabling a
+capability must never remove code — only the switch + entry visibility
+(project plan ADR D4/D5).
+
+Both the endpoint and the dependency read ``config.CAPABILITIES`` at request
+time (module attribute, not a snapshot), so tests can monkeypatch
+``config.CAPABILITIES`` and the next request reflects the new value.
+"""
+
+from fastapi import APIRouter, Depends, HTTPException
+
+import config
+
+router = APIRouter()
+
+
+@router.get("/capabilities")
+async def get_capabilities() -> dict:
+    """Return the flat capability registry for this deployment."""
+    return dict(config.CAPABILITIES)
+
+
+def require_capability(name: str):
+    """Dependency factory gating a route/router on a capability switch.
+
+    Usage: ``Depends(require_capability("scp"))`` on the route, or
+    ``APIRouter(dependencies=[Depends(require_capability("scp"))])`` on the
+    whole router. Returns 503 when the switch is off; a no-op when it is on.
+    An unknown capability name is treated as unavailable (fail-safe).
+    """
+    def _guard() -> None:
+        if not config.CAPABILITIES.get(name):
+            raise HTTPException(
+                status_code=503,
+                detail=f"{name} is unavailable in this deployment",
+            )
+    return _guard
