+"""Endpoint-level tests for the capabilities API (api/capabilities.py).
+
+GET /api/capabilities exposes config.CAPABILITIES as flat JSON; the endpoint
+and the require_capability dependency read the config module attribute at
+request time, so monkeypatching config.CAPABILITIES is picked up by the next
+request. Uses a small FastAPI app + TestClient, mirroring
+test_folder_visibility_middleware.py.
+"""
+
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+
+import pytest
+from fastapi import Depends, FastAPI
+from starlette.testclient import TestClient
+
+import config
+from api import capabilities
+
+# The flat registry contract shared with the frontend.
+EXPECTED_KEYS = {
+    "gateway", "datalab", "hf", "arena", "claude", "s3",
+    "volcengine", "scp", "ray_quality", "traj_viz", "workbench",
+}
+
+
+@pytest.fixture
+def client():
+    app = FastAPI()
+    app.include_router(capabilities.router, prefix="/api")
+    return TestClient(app)
+
+
+def test_default_all_enabled(client):
+    """All switches default on: the registry is the full flat True set."""
+    resp = client.get("/api/capabilities")
+    assert resp.status_code == 200
+    body = resp.json()
+    assert set(body.keys()) == EXPECTED_KEYS
+    assert all(body.values())
+
+
+def test_partial_false_reflected(client, monkeypatch):
+    """A monkeypatched registry is served verbatim (read at request time)."""
+    patched = dict(config.CAPABILITIES)
+    patched["gateway"] = False
+    patched["workbench"] = False
+    monkeypatch.setattr(config, "CAPABILITIES", patched)
+
+    body = client.get("/api/capabilities").json()
+    assert body == patched
+    assert body["gateway"] is False and body["workbench"] is False
+    assert body["datalab"] is True
+
+
+def _guarded_app():
+    app = FastAPI()
+
+    @app.get("/guarded")
+    async def guarded(_: None = Depends(capabilities.require_capability("scp"))):
+        return {"ok": True}
+
+    return app
+
+
+def test_require_capability_enabled():
+    """Switch on: the dependency is a no-op and the route serves 200."""
+    resp = TestClient(_guarded_app()).get("/guarded")
+    assert resp.status_code == 200
+    assert resp.json() == {"ok": True}
+
+
+def test_require_capability_disabled(monkeypatch):
+    """Switch off: the dependency 503s with the deployment detail."""
+    patched = dict(config.CAPABILITIES)
+    patched["scp"] = False
+    monkeypatch.setattr(config, "CAPABILITIES", patched)
+
+    resp = TestClient(_guarded_app()).get("/guarded")
+    assert resp.status_code == 503
+    assert resp.json()["detail"] == "scp is unavailable in this deployment"
