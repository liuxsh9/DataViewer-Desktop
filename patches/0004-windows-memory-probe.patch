 def _available_memory_mb() -> int:
-    """Linux MemAvailable (MB). 0 when unreadable → caller falls back to CPU."""
+    """Available memory (MB). Linux: MemAvailable from /proc/meminfo.
+    Non-Linux (Windows): psutil.virtual_memory().available, so worker sizing
+    and the memory guard stay meaningful on Windows (no /proc/meminfo).
+    0 when unreadable → callers fall back to CPU-based sizing / skip the
+    memory check."""
+    if sys.platform != "linux":
+        try:
+            return psutil.virtual_memory().available // (1024 * 1024)
+        except Exception:
+            return 0
     try:
