- Windows 无 flock：_acquire_lock 为文档化 no-op，锁语义用例 win32 跳过
- Linux 行为不变

Co-Authored-By: Claude <noreply@anthropic.com>
---
 backend/tests/test_writeback_service.py | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/backend/tests/test_writeback_service.py b/backend/tests/test_writeback_service.py
index f41a1d0..0eeb9ee 100644
--- a/backend/tests/test_writeback_service.py
+++ b/backend/tests/test_writeback_service.py
@@ -4,10 +4,11 @@ import os
 import sys
 import tempfile
 import shutil
-import fcntl
 from pathlib import Path
 from unittest.mock import patch, MagicMock
 
+import pytest
+
 sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
 
 from services.writeback_service import (
@@ -530,6 +531,8 @@ def test_scan_jsonl_files_skips_pass_directory():
 
 # ==================== Test _acquire_lock / _release_lock ====================
 
+@pytest.mark.skipif(sys.platform == "win32",
+                    reason="no flock(2) on Windows; _acquire_lock is a documented no-op there")
 def test_acquire_and_release_lock():
     """Test acquiring and releasing a file lock."""
     tmpdir = tempfile.mkdtemp()
@@ -547,6 +550,8 @@ def test_acquire_and_release_lock():
         shutil.rmtree(tmpdir)
 
 
+@pytest.mark.skipif(sys.platform == "win32",
+                    reason="no flock(2) on Windows; _acquire_lock is a documented no-op there")
 def test_acquire_lock_contention():
     """Test that a second lock attempt fails when the first is held."""
     tmpdir = tempfile.mkdtemp()
