From 1d481695019c2dd88752211bff2b9a4cf1c0154b Mon Sep 17 00:00:00 2001
From: DataViewer-Desktop Sync <sync@dataviewer-desktop.local>
Date: Thu, 20 Aug 2026 13:37:44 +0800
Subject: [PATCH 11/15] fix(desktop): declare cryptography in base deps
 (gateway_credentials import)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- 原经 ray[default] 传递依赖满足；依赖拆分后 Windows base 闭包缺失
- 用 python3 -S + pip --target 模拟 base 闭包验证：零缺失、918 全收集

Co-Authored-By: Claude <noreply@anthropic.com>
---
 backend/pyproject.toml | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/backend/pyproject.toml b/backend/pyproject.toml
index 1701a9e..5a2048f 100644
--- a/backend/pyproject.toml
+++ b/backend/pyproject.toml
@@ -9,6 +9,10 @@ dependencies = [
     "aiofiles>=23.2.1",
     "python-multipart>=0.0.20",
     "pyjwt>=2.8.0",
+    # Declared explicitly: gateway_credentials.py imports cryptography.fernet.
+    # Previously satisfied only transitively via ray[default]; the desktop
+    # dependency split (patch 0005) exposed the missing declaration.
+    "cryptography>=42.0.0",
     "orjson>=3.11.7",
     "opencc>=1.3.1",
     "bcrypt>=4.1.2",
-- 
2.43.0

