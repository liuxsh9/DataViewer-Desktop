diff --git a/backend/utils/process_context.py b/backend/utils/process_context.py
new file mode 100644
index 0000000..9992c09
--- /dev/null
+++ b/backend/utils/process_context.py
@@ -0,0 +1,41 @@
+"""
+Unified multiprocessing start-method resolution.
+
+The upstream backend's multi-process code is written against fork semantics
+(zero-copy ProcessPoolExecutor pools). Windows has no fork — only spawn — so
+every multiprocessing entry point must create its context through
+:func:`get_context` instead of relying on the platform default:
+
+- ``DV_MP_START_METHOD`` env var forces a method on any platform
+  (``DV_MP_START_METHOD=spawn`` on Linux is the CI pre-validation for the
+  Windows single-machine build); an invalid value raises ValueError at first
+  use instead of silently falling back.
+- Unset: ``win32`` → ``spawn`` (the only method Windows provides), anything
+  else → ``fork`` (upstream's original semantics — Linux behavior is
+  byte-for-byte unchanged).
+"""
+import multiprocessing
+import os
+import sys
+from typing import Optional
+
+_VALID_METHODS = ("fork", "spawn", "forkserver")
+
+
+def get_context(method: Optional[str] = None) -> multiprocessing.context.BaseContext:
+    """Resolve and return a multiprocessing context.
+
+    Precedence:
+    1. ``method`` argument — explicit override, for modules with deliberate
+       spawn-always semantics (parquet_conversion_manager). Normally None.
+    2. ``DV_MP_START_METHOD`` env var (one of fork/spawn/forkserver).
+    3. Platform default: ``win32`` → ``spawn``, other platforms → ``fork``.
+    """
+    if method is None:
+        method = os.environ.get("DV_MP_START_METHOD")
+        if method is None:
+            method = "spawn" if sys.platform == "win32" else "fork"
+    if method not in _VALID_METHODS:
+        raise ValueError(
+            f"DV_MP_START_METHOD must be one of {_VALID_METHODS}, got {method!r}")
+    return multiprocessing.get_context(method)
