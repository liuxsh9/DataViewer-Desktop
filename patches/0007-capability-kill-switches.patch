index 0000000..2dce9c0
--- /dev/null
+++ b/backend/tests/test_capability_gates.py
@@ -0,0 +1,121 @@
+"""Capability-gate tests for externally switchable routers (M1 4.7).
+
+Routers of external-service capabilities (s3, traj_viz, claude, hf, arena,
+volcengine) carry a router-level ``require_capability`` dependency
+(api/capabilities.py) that 503s every route before its handler runs when the
+switch is off. Each test builds a minimal FastAPI app with the real router
+(mirroring test_capabilities_api.py) and asserts: switch on → pre-existing
+behavior unchanged; switch off → 503 "<name> is unavailable in this
+deployment".
+
+Not covered here by design:
+- gateway: already enforced with the legacy ``GATEWAY_PUSH_ENABLED`` 403
+  check in api/gateway_push.py (push and pull routes in the same router).
+- scp route gates: api/files.py (another workstream) gates /scp-download and
+  /scp-tasks; the service-level guard in services/scp_download_manager.py is
+  unit-tested below.
+"""
+
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+
+import pytest
+from fastapi import FastAPI
+from starlette.testclient import TestClient
+from starlette.websockets import WebSocketDisconnect
+
+import config
+from api import arena, claude_terminal, distillation, hf_download, s3, trajlens
+from services import scp_download_manager
+
+
+def _capabilities_with(name: str, value: bool) -> dict:
+    patched = dict(config.CAPABILITIES)
+    patched[name] = value
+    return patched
+
+
+def _client(router, prefix: str) -> TestClient:
+    app = FastAPI()
+    app.include_router(router, prefix=prefix)
+    return TestClient(app)
+
+
+# One case per gated router. ``path``/``method``/``body`` pick the lightest
+# route in each router (read-only or validation-only), and ``enabled_status``
+# is its pre-gate behavior — asserting it proves the gate is a no-op when on.
+ROUTER_CASES = [
+    # (router, prefix, capability, path, method, body, enabled_status)
+    (s3.router, "/api/s3", "s3", "/api/s3/tasks", "get", None, 200),
+    (trajlens.router, "/api", "traj_viz", "/api/trajlens/ingest", "post", {}, 422),
+    (claude_terminal.router, "/api/claude-terminal", "claude", "/api/claude-terminal/sessions", "get", None, 200),
+    (hf_download.router, "", "hf", "/api/hf/tasks", "get", None, 200),
+    (arena.router, "/api", "arena", "/api/arena/models", "get", None, 401),
+    (distillation.router, "", "volcengine", "/api/distillation/tasks", "get", None, 200),
+]
+
+
+@pytest.mark.parametrize(
+    "router,prefix,cap,path,method,body,enabled_status",
+    ROUTER_CASES,
+    ids=[c[2] for c in ROUTER_CASES],
+)
+def test_router_gate(router, prefix, cap, path, method, body, enabled_status, monkeypatch):
+    client = _client(router, prefix)
+
+    # Switch on: pre-existing behavior, the gate must be a no-op.
+    resp = client.request(method, path, json=body) if body is not None else client.request(method, path)
+    assert resp.status_code == enabled_status
+
+    # Switch off: explicit 503 before any handler (and any auth) runs.
+    monkeypatch.setattr(config, "CAPABILITIES", _capabilities_with(cap, False))
+    resp = client.request(method, path, json=body) if body is not None else client.request(method, path)
+    assert resp.status_code == 503
+    assert resp.json()["detail"] == f"{cap} is unavailable in this deployment"
+
+
+def test_claude_terminal_websocket_gated(monkeypatch):
+    """The terminal WebSocket is gated by the same router dependency.
+
+    The dependency runs before the endpoint (which would accept the socket),
+    so Starlette's exception middleware answers the handshake with a close —
+    the client sees a disconnect instead of a session.
+    """
+    client = _client(claude_terminal.router, "/api/claude-terminal")
+    monkeypatch.setattr(config, "CAPABILITIES", _capabilities_with("claude", False))
+    with pytest.raises(WebSocketDisconnect):
+        with client.websocket_connect("/api/claude-terminal/ws/project"):
+            pass
+
+
+class TestScpServiceGuard:
+    """Service-level SCP guard (services/scp_download_manager.py).
+
+    Route-level 503s for /scp-download and /scp-tasks live in api/files.py
+    (another workstream); this guard raises a clear error for direct service
+    callers. The enabled path is exercised only on read functions — creating
+    a task would spawn real rsync transfers.
+    """
+
+    def test_create_download_task_disabled(self, monkeypatch):
+        monkeypatch.setattr(config, "SCP_ENABLED", False)
+        with pytest.raises(RuntimeError, match="SCP download is unavailable in this deployment"):
+            scp_download_manager.create_download_task(
+                "10.0.0.1", "user", "pw", "/remote/data", "/local/data")
+
+    def test_read_functions_disabled(self, monkeypatch):
+        monkeypatch.setattr(config, "SCP_ENABLED", False)
+        with pytest.raises(RuntimeError, match="SCP download is unavailable in this deployment"):
+            scp_download_manager.get_task("scp_missing")
+        with pytest.raises(RuntimeError, match="SCP download is unavailable in this deployment"):
+            scp_download_manager.get_all_tasks()
+        with pytest.raises(RuntimeError, match="SCP download is unavailable in this deployment"):
+            scp_download_manager.get_task_history()
+
+    def test_enabled_read_behavior_unchanged(self):
+        # Empty store → the same results as before the guard existed.
+        assert scp_download_manager.get_task("scp_missing") is None
+        assert scp_download_manager.get_task_history() == []
+        assert scp_download_manager._ensure_scp_enabled() is None
